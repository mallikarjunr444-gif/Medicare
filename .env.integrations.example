# MediCare — open-source integration settings. COPY, never commit real values.
# Worker secrets are set with:  cd workers/api && npx wrangler secret put <NAME> --env production
# Website values (NEXT_PUBLIC_*) are PUBLIC by design; put them in GitHub → Settings → Variables (not secrets).

# ── Worker secrets (never in the frontend) ───────────────────────────────────
DATABASE_URL=            # Neon connection string (already set)
JWT_SECRET_KEY=          # >= 32 random chars (already set)
SENTRY_DSN=              # Sentry OR a self-hosted GlitchTip DSN (same format); optional
CAPTCHA_SECRET=          # random 32+ chars. Setting it turns ALTCHA ON for register / forgot-password / email-code request
EMAIL_API_KEY=           # key for the HTTP email provider (verification, reset, sign-in codes)
EMAIL_FROM=              # e.g. MediCare <no-reply@yourdomain>  (domain must be verified with the provider)
# EMAIL_API_URL=         # optional; defaults to the Resend-compatible endpoint. Any HTTP email API with the same JSON shape works.

# ── Worker plain variables (wrangler.jsonc "vars"; not secret) ──────────────
APPCHECK_PROJECT_NUMBER= # Firebase Console → Project settings → General → Project number (digits)
APPCHECK_ENFORCE=false   # flip to "true" ONLY after the site is sending App Check tokens (see docs/integrations/SETUP.md)
FIREBASE_PROJECT_ID=medicus-labs
CORS_ORIGINS=            # exact origins, comma separated

# ── Website build variables (public) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APPCHECK_SITE_KEY=     # reCAPTCHA v3 SITE key registered in Firebase App Check (public). Empty = App Check off
NEXT_PUBLIC_UMAMI_SRC=             # e.g. https://analytics.example.com/script.js   Empty = no analytics at all
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
